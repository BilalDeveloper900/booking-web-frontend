{
  "name": "Book It Daily — Salon Booking",
  "short_name": "Book It Daily",
  "description": "Manage your salon bookings, admins, and clients.",
  "id": "/?source=pwa",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "portrait",
  "background_color": "#fafaf9",
  "theme_color": "#222222",
  "lang": "en",
  "dir": "ltr",
  "categories": ["lifestyle", "business", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/bookitdaily-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/bookitdaily-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/bookitdaily-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "description": "Today's schedule and upcoming bookings",
      "url": "/owner/calendar?source=shortcut",
      "icons": [{ "src": "/icons/bookitdaily-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Book a session",
      "short_name": "Book",
      "description": "Book a new session as a client",
      "url": "/client/book?source=shortcut",
      "icons": [{ "src": "/icons/bookitdaily-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Messages",
      "short_name": "Messages",
      "description": "Chat with your stylist or clients",
      "url": "/client/messages?source=shortcut",
      "icons": [{ "src": "/icons/bookitdaily-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ]
}
