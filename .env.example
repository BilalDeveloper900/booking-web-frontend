# ─────────────────────────────────────────────────────────────────────────────
# Maison & Co. — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored; never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — find these in Project Settings → API in Supabase Studio.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Lemon Squeezy — fill in when wiring SaaS billing (Phase 6).
# LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_STORE_ID=
# LEMON_SQUEEZY_SIGNING_SECRET=

# Resend — fill in when wiring transactional email (Phase 5/6).
# RESEND_API_KEY=

# App URL — used in webhook callbacks, email links, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000
